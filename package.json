{
  "name": "dsh-github-copilot",
  "description": "First-class GitHub Copilot model and hosted-search integration for DeepSeek Harness.",
  "version": "0.3.0-cloga.8",
  "packageManager": "pnpm@11.7.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloga/dsh-github-copilot.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./remote": {
      "types": "./lib/types/remote.d.ts",
      "default": "./lib/remote.js"
    },
    "./deployment-baseline.json": "./deployment-baseline.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "deployment-baseline.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/remote.js",
    "lib/*.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-search",
    "github-copilot",
    "model-provider",
    "responses-api",
    "openai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && tsdown",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "prepare": "tsc -p tsconfig.json && tsdown",
    "prepack": "pnpm verify:baseline",
    "prepublishOnly": "pnpm test && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:baseline": "node scripts/verify-deployment-baseline.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:controlled-core": "node scripts/verify-controlled-core.mjs",
    "verify:upstream": "node scripts/verify-upstream-baseline.mjs",
    "verify": "pnpm typecheck && pnpm verify:baseline && pnpm build && pnpm test && pnpm verify:package"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-authorization": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings-models": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-authorization": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-models": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-authorization": "^0.1.1-rc.2 || ^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@earendil-works/pi-ai": "^0.84.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-authorization": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "^0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "imports": {
    "#package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  }
}
