{
  "schemaVersion": 1,
  "baseline": {
    "id": "cloga.dsh-github-copilot",
    "kind": "fork-deployment-baseline",
    "source": "https://github.com/cloga/dsh-web-search-provider",
    "sourceCommitPolicy": "exact-external-pin",
    "upstream": "https://github.com/hiyms/dsh-web-search-provider"
  },
  "package": {
    "name": "dsh-github-copilot",
    "version": "0.3.0-cloga.1"
  },
  "supportedBaselines": {
    "platforms": [
      "windows"
    ],
    "node": ">=22.0.0",
    "dsh": {
      "release": "0.1.1-rc.2",
      "developmentRelease": "0.1.2-alpha.3",
      "peerRange": "^0.1.1-rc.2 || ^0.1.2-alpha.2",
      "packages": [
        "@deepseek-ai/dsh-agent",
        "@deepseek-ai/dsh-agent-default-model",
        "@deepseek-ai/dsh-credentials",
        "@deepseek-ai/dsh-launch-environment",
        "@deepseek-ai/dsh-llm",
        "@deepseek-ai/dsh-settings",
        "@deepseek-ai/dsh-web"
      ]
    },
    "copilot": {
      "apis": [
        "openai-responses",
        "openai-completions"
      ],
      "modelCatalogEndpoint": "/v1/models",
      "metadataProfile": "optional-copilot-model-capabilities",
      "mainAgent": true,
      "acpSubagents": false
    }
  },
  "capabilities": [
    {
      "id": "responses-replay-item-id-normalization",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/serialize.ts",
          "marker": "const replayItemId = /^fc_[A-Za-z0-9_-]{1,61}$/.test(itemId)"
        }
      ],
      "tests": [
        {
          "file": "tests/inline/serialize.spec.ts",
          "name": "maps invalid replay item ids to stable short ids"
        },
        {
          "file": "tests/inline/serialize.spec.ts",
          "name": "maps oversized replay item ids to stable short ids"
        }
      ]
    },
    {
      "id": "grounded-sandbox-escalation",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/wire.ts",
          "marker": "function hasGroundedSandboxEscalation"
        },
        {
          "file": "src/wire.ts",
          "marker": "function sanitizeSandboxEscalationArguments"
        }
      ],
      "tests": [
        {
          "file": "tests/inline/wire.spec.ts",
          "name": "removes speculative sandbox escalation arguments from full-access tool calls"
        },
        {
          "file": "tests/inline/wire.spec.ts",
          "name": "preserves sandbox escalation arguments when retrying a real DSH denial"
        }
      ]
    },
    {
      "id": "official-vision-route-bypass",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/index.ts",
          "marker": "if (contentHasImageAttachments(request)) return false"
        }
      ],
      "tests": [
        {
          "file": "tests/inline/apply.spec.ts",
          "name": "preserves image attachments when bypassing the custom wire"
        }
      ]
    },
    {
      "id": "github-copilot-model-catalog",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/model-catalog.ts",
          "marker": "export async function synchronizeOpenAICompatibleModelCatalog"
        },
        {
          "file": "src/model-catalog.ts",
          "marker": "return options.fallback"
        }
      ],
      "tests": [
        {
          "file": "tests/model-catalog.spec.ts",
          "name": "maps rich Copilot metadata for selectable interactive models"
        },
        {
          "file": "tests/model-catalog.spec.ts",
          "name": "requests /v1/models and returns the static fallback when discovery fails"
        }
      ]
    },
    {
      "id": "github-copilot-route-composition",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/copilot-provider.ts",
          "marker": "export function composeGitHubCopilotProviderRoutes"
        },
        {
          "file": "src/copilot-provider.ts",
          "marker": "api: 'openai-completions'"
        }
      ],
      "tests": [
        {
          "file": "tests/copilot-provider.spec.ts",
          "name": "composes Responses and Chat routes with catalog metadata intact"
        },
        {
          "file": "tests/copilot-provider.spec.ts",
          "name": "fails closed for invalid route input"
        }
      ]
    },
    {
      "id": "dsh-runtime-compatibility-guard",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/compatibility.ts",
          "marker": "export function assertDshCompatibility"
        },
        {
          "file": "src/index.ts",
          "marker": "assertDshCompatibility(ctx)"
        }
      ],
      "tests": [
        {
          "file": "tests/compatibility.spec.ts",
          "name": "accepts the supported DSH service contract"
        },
        {
          "file": "tests/compatibility.spec.ts",
          "name": "fails before startup when a required API is absent"
        }
      ]
    },
    {
      "id": "orphaned-replay-item-filtering",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/serialize.ts",
          "marker": "export function pairedToolCallIds"
        }
      ],
      "tests": [
        {
          "file": "tests/inline/serialize.spec.ts",
          "name": "keeps only call ids with both replay halves"
        },
        {
          "file": "tests/inline/serialize.spec.ts",
          "name": "drops orphaned replay calls and results while preserving paired calls"
        }
      ]
    },
    {
      "id": "traditional-search-compatibility-bridge",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/traditional-search.ts",
          "marker": "export const GITHUB_COPILOT_HOSTED_SEARCH_PROVIDER_ID = 'github-copilot-hosted'"
        },
        {
          "file": "src/index.ts",
          "marker": "ctx.web.registerSearchProvider(createTraditionalSearchProvider("
        }
      ],
      "tests": [
        {
          "file": "tests/inline/apply.spec.ts",
          "name": "registers the github-copilot-hosted traditional search provider without a fetch provider"
        },
        {
          "file": "tests/traditional-search.spec.ts",
          "name": "normalizes generated content and deduplicated sources"
        },
        {
          "file": "tests/traditional-search.spec.ts",
          "name": "honors caller abort before credential or network access"
        },
        {
          "file": "tests/inline/apply.spec.ts",
          "name": "coexists with another traditional search provider without replacing it"
        }
      ]
    },
    {
      "id": "nonempty-reasoning-blocks",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/wire.ts",
          "marker": "if (slot.text.trim().length === 0) break"
        },
        {
          "file": "src/wire-anthropic.ts",
          "marker": "if (slot.text.trim().length === 0) break"
        }
      ],
      "tests": [
        {
          "file": "tests/inline/wire.spec.ts",
          "name": "drops reasoning items that emit only whitespace"
        },
        {
          "file": "tests/inline/wire-anthropic.spec.ts",
          "name": "drops thinking blocks that emit only whitespace"
        }
      ]
    },
    {
      "id": "settings-provider-instance-api",
      "required": true,
      "sourceMarkers": [
        {
          "file": "src/index.ts",
          "marker": "settingsCtx.settings.installSection(ctx, GITHUB_COPILOT_SETTINGS_NAMESPACE"
        }
      ],
      "tests": [
        {
          "file": "tests/inline/apply.spec.ts",
          "name": "uses the settings provider instance API when legacy helpers are absent"
        }
      ]
    }
  ],
  "requiredExports": {
    ".": [
      "modelCatalogURL",
      "githubCopilotModelCatalogURL",
      "modelsFromGitHubCopilotListing",
      "modelsFromOpenAICompatibleListing",
      "synchronizeGitHubCopilotModelCatalog",
      "synchronizeOpenAICompatibleModelCatalog",
      "composeGitHubCopilotProviderRoutes",
      "GITHUB_COPILOT_PROVIDER_ID",
      "GITHUB_COPILOT_CHAT_PROVIDER_ID",
      "GITHUB_COPILOT_API_KEY_ENV",
      "DSH_COMPATIBILITY",
      "assertDshCompatibility",
      "GITHUB_COPILOT_HOSTED_SEARCH_PROVIDER_ID"
    ],
    "./deployment-baseline.json": []
  }
}
